<?xml version="1.0" encoding="UTF-8"?>
<!--
  Forge — signed MSI installer (WiX v4). Packages the built add-in output, registers the
  COM class (RegAsm, same registration the dev .bat does), and writes SolidWorks add-in
  discovery keys under HKLM. Produces a single-file Forge-Setup.msi that a signed release
  can ship so Smart App Control trusts it.

  Build (on a machine with the .NET SDK + SolidWorks interop):
    powershell -File installer/build-msi.ps1
  or stepwise:
    wix harvest dir solidworks\bin\x64\Release -directoryref INSTALLFOLDER -o installer\FileComponents.wxs -g ForgeAddinFiles
    dotnet build installer\Forge.Setup.wixproj -c Release

  FileComponents.wxs is GENERATED by the harvest step (absolute paths) and is gitignored.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!-- ProductCode is PINNED (not auto-generated): winget's installer manifest must reference the
       exact MSI ProductCode, and a stable identity keeps MajorUpgrade + per-version winget-pkgs
       manifests correct. Keep in sync with winget/Forge.Forge.installer.yaml. -->
  <Package
      Name="Forge"
      Manufacturer="Forge"
      Version="0.1.0"
      ProductCode="3A7C9E11-B2F4-4D6E-8A1C-5B9D3F7C2E4A"
      UpgradeCode="7A1D0A4E-2B8F-4C6E-9D3A-5E4F2C8B1A6D"
      Language="1033"
      Scope="perMachine"
      Platform="x64">
    <SummaryInformation Description="Forge — talk to SolidWorks, get verified changes" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Forge is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Forge" />
    </StandardDirectory>

    <!-- .NET Framework v4.0.30319 RegAsm.exe (a SolidWorks 2022+ machine already has .NET Framework 4.8). -->
    <StandardDirectory Id="WindowsFolder">
      <Directory Id="MicrosoftNET" Name="Microsoft.NET">
        <Directory Id="Framework64Dir" Name="Framework64">
          <Directory Id="v4_0_30319" Name="v4.0.30319" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="ForgeAddin" Title="Forge" Description="Forge — AI for SolidWorks" Level="1">
      <ComponentGroupRef Id="ForgeAddinFiles" />
      <ComponentRef Id="ForgeSolidWorksKeys" />
    </Feature>

    <!-- SolidWorks add-in discovery keys. GUID = the SwAddin CLSID from solidworks/SwAddin.cs
         ([Guid("8f3c9e21-4b6a-4c2d-9e1f-2a7b5c8d3e40")]) — keep in sync. The COM class itself is
         registered by the RegAsm custom actions below, same as solidworks/Register-Forge.bat. -->
    <Component Id="ForgeSolidWorksKeys" Directory="INSTALLFOLDER">
      <RegistryKey Root="HKLM" Key="SOFTWARE\SolidWorks\Addins\{8F3C9E21-4B6A-4C2D-9E1F-2A7B5C8D3E40}">
        <RegistryValue Type="integer" Value="1" KeyPath="yes" />
        <RegistryValue Name="Title" Value="Forge" Type="string" />
        <RegistryValue Name="Description" Value="Forge — AI for SolidWorks" Type="string" />
      </RegistryKey>
      <RegistryKey Root="HKLM" Key="SOFTWARE\SolidWorks\AddInsStartup\{8F3C9E21-4B6A-4C2D-9E1F-2A7B5C8D3E40}">
        <RegistryValue Type="integer" Value="1" />
      </RegistryKey>
    </Component>

    <CustomAction Id="RegForgeCom" Directory="v4_0_30319"
        ExeCommand="&quot;[v4_0_30319]RegAsm.exe&quot; /codebase &quot;[INSTALLFOLDER]Forge.SolidWorks.dll&quot;"
        Execute="deferred" Impersonate="no" Return="check" />

    <CustomAction Id="UnregForgeCom" Directory="v4_0_30319"
        ExeCommand="&quot;[v4_0_30319]RegAsm.exe&quot; /unregister &quot;[INSTALLFOLDER]Forge.SolidWorks.dll&quot;"
        Execute="deferred" Impersonate="no" Return="check" />

    <InstallExecuteSequence>
      <Custom Action="RegForgeCom" After="InstallFiles" Condition="NOT Installed AND NOT REMOVE" />
      <Custom Action="UnregForgeCom" Before="RemoveFiles" Condition="REMOVE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
