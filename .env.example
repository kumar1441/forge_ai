# copy to your environment / setx — NEVER commit real values

# REQUIRED: your LLM provider API key (the BYOK path). Set as an env var — never in config.json.
FORGE_PROVIDER_KEY=

# OPTIONAL: API key for the hosted Forge endpoint.
FORGE_MCP_API_KEY=

# OPTIONAL: override the primary model.
FORGE_MODEL_PRIMARY=

# OPTIONAL: override the lightweight model.
FORGE_MODEL_LIGHT=
